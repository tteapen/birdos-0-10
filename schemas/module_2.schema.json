{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "mechanisms"
  ],
  "properties": {
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "account"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "distinct_because": {
            "type": "string"
          },
          "near_duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "rests_on": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
