{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "verdicts"
  ],
  "properties": {
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "verdict",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "reject"
            ]
          },
          "failed_filter": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "scores": {
            "type": [
              "object",
              "null"
            ]
          },
          "literature_overlap": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
