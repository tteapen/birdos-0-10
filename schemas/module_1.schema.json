{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "fields",
    "biology_confidence"
  ],
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "key",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "status": {
            "enum": [
              "stated",
              "inferred",
              "unknown"
            ]
          }
        }
      }
    },
    "biology_confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "confidence_note": {
      "type": "string"
    }
  }
}
